# Definidas pelo projeto Supabase na Vercel; nunca suba valores reais ao Git.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Segredo de 32+ caracteres usado para anonimizar IPs na limitação de requisições.
REQUEST_HASH_SALT=
# URL canônica de produção para validação de origem das APIs.
NEXT_PUBLIC_SITE_URL=https://cr-solucoes-epis.vercel.app
# Área administrativa: defina valores reais somente nas Environment Variables da Vercel.
# ADMIN_PASSWORD deve ser Teste123 apenas para o primeiro acesso; altere-o em seguida.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
